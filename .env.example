# Losto environment variables.
#
# Copy to .env.local for development, or add these in Vercel under
# Settings -> Environment Variables. Only LOSTO_EFFECTIVE is required.
#
# NEXT_PUBLIC_* values are inlined into the client bundle at build time, so
# changing one in Vercel needs a redeploy before it shows up.

# ---------------------------------------------------------------- required --
# Effective date of the privacy notice. Until this is set, /legal shows a
# "not ready to publish" banner instead of presenting itself as a valid notice.
NEXT_PUBLIC_LOSTO_EFFECTIVE="DD MONTH YYYY"

# ------------------------------------------------- publisher and contacts --
# These have working defaults in lib/legal.ts. Set them explicitly anyway, so
# the notice does not silently change if a default is edited.
NEXT_PUBLIC_LOSTO_OPERATOR="Company Name"
NEXT_PUBLIC_LOSTO_CONTACT="company@example.com"
NEXT_PUBLIC_LOSTO_GRIEVANCE="company@example.com"
NEXT_PUBLIC_LOSTO_JURISDICTION="Country"

# --------------------------------------------------------------- fetching --
# The URL a site owner lands on from Losto's user agent. It MUST resolve to a
# real page explaining who is fetching and how to object - the honest-identity
# posture in FETCHING.md depends on it.
LOSTO_BOT_URL="https://example.com/losto-bot"

# Name used in the user agent and matched against robots.txt group names.
# Changing it means site owners' existing rules stop matching.
LOSTO_BOT_NAME="LostoReader"

# ---------------------------------------------------------------- optional --
# Leave all three unset unless you specifically need them.

# Replaces the user agent entirely. Setting a browser string here removes the
# honest identification and is not recommended.
# LOSTO_USER_AGENT=

# "1" disables the browser-compatibility retry, so Losto always stays
# identified and simply fails on sites that refuse non-browser requests.
# LOSTO_STRICT_UA=1

# Comma-separated allow list for the media proxy. Unset means any host, subject
# to robots.txt, the media content-type check and the size cap.
# LOSTO_ASSET_HOSTS=
